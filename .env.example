# Supabase connection for account sync. Copy to `.env` and fill in.
# The publishable (anon) key is safe to ship in a client — row-level
# security is what actually protects data.
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable
VITE_SUPABASE_SCHEMA=public

# Todofy Pro billing service. Leave blank to build without Pro: Cloud Sync then
# runs unmetered, which is what a self-hosted setup wants. Official builds point
# this at the hosted service, which must also be listed in the `connect-src` CSP
# in `src-tauri/tauri.conf.json`.
VITE_TODOFY_API_URL=

# Google Calendar sync (optional). A "Desktop app" OAuth client from Google
# Cloud Console. The client secret is embedded per Google's installed-app flow
# and is not treated as confidential. Leave blank to ship without calendar sync.
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret
